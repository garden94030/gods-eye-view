{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "garden94030-gods-eye-view",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "GodsEyeContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GODS_EYE_CONTAINER",
        "class_name": "GodsEyeContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GodsEyeContainer"]
    }
  ]
}
