#!/bin/zsh
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
NODE_BIN="/opt/homebrew/bin/node"
NPM_BIN="/opt/homebrew/bin/npm"
export PATH="/opt/homebrew/bin:/usr/bin:/bin"
APP_URL="http://127.0.0.1:4173"
STATE_DIR="/tmp/gods-eye-view-${UID}"
LOG_FILE="$STATE_DIR/server.log"
PID_FILE="$STATE_DIR/server.pid"
SERVER_PID=""

show_error() {
  /usr/bin/osascript -e 'display dialog "Gods Eye View 無法啟動。請查看 /tmp/gods-eye-view-<你的 UID>/server.log。" with title "Gods Eye View" buttons {"好"} default button "好"' >/dev/null 2>&1 || true
}

if [[ ! -x "$NODE_BIN" || ! -x "$NPM_BIN" || ! -f "$PROJECT_ROOT/package.json" ]]; then
  show_error
  exit 1
fi

mkdir -p "$STATE_DIR"

# Reuse an already-running local instance owned by this project.
if /usr/bin/curl -fsS --max-time 1 "$APP_URL" >/dev/null 2>&1; then
  /usr/bin/open "$APP_URL"
  exit 0
fi

cd "$PROJECT_ROOT"
nohup env HOST=127.0.0.1 PORT=4173 "$NPM_BIN" run dev -- --host 127.0.0.1 --port 4173 \
  >>"$LOG_FILE" 2>&1 < /dev/null &
SERVER_PID=$!
printf '%s\n' "$SERVER_PID" > "$PID_FILE"

for attempt in {1..60}; do
  if /usr/bin/curl -fsS --max-time 1 "$APP_URL" >/dev/null 2>&1; then
    /usr/bin/open "$APP_URL"
    # The server is intentionally detached from this short-lived launcher.
    # Keeping the launcher alive makes macOS report the .app as unresponsive.
    exit 0
  fi
  /bin/sleep 0.5
done

show_error
exit 1
